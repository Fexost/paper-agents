# Server (also baked into npm start scripts; override here if needed)
PORT=3001

# Postgres — use local Docker, Neon, or `npx prisma dev`
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/paper_agents?schema=public"

# LLM routing — pick one primary provider; fallbacks are tried in order
LLM_PRIMARY=ollama
LLM_FALLBACKS=omniroute

# OmniRoute — OpenAI-compatible gateway (https://github.com/diegosouzapw/OmniRoute)
# Point base URL at your local OmniRoute instance after setup
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=omniroute
OMNIROUTE_MODEL=gemini-2.5-flash

# Ollama — local models (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Market data — optional Finnhub free tier for live quotes
FINNHUB_API_KEY=
# Snapshot cache (ms): live quotes 15s; mock/backoff 30s; Finnhub retry backoff 60s
MARKET_SNAPSHOT_TTL_MS=15000
MARKET_MOCK_TTL_MS=30000
MARKET_FINNHUB_BACKOFF_MS=60000

# Paper trading
PAPER_STARTING_CASH=100000
MAX_POSITION_PCT=0.1

# Pipeline
DAILY_CYCLE_CRON=0 7 * * 1-5
AUTO_RUN_DAILY_CYCLE=false

# Autoresearch — evaluation window in paper-run days (ATLAS keep/revert)
AUTORESEARCH_EVAL_DAYS=5
